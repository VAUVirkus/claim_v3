# VAU Claim System v3 - Keskkonnakonfiguratsioon
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3001

# Andmebaas (vaikimisi sqlite kohalikuks tööks, toetab ka mariadb/mysql)
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite

# MariaDB (Zone.eu või tootmiskeskkond)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vau_claim_v3
# DB_USERNAME=vau_user
# DB_PASSWORD=

# CORS lubatud päritolud
CORS_ALLOWED_ORIGINS=*
